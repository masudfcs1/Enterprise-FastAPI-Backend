{
  "name": "fastapi-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": ".venv\\Scripts\\uvicorn.exe app.main:app --reload --port 8000",
    "start": ".venv\\Scripts\\uvicorn.exe app.main:app --port 8000",
    "test": ".venv\\Scripts\\pytest.exe -v",
    "prisma:generate": ".venv\\Scripts\\prisma.exe generate --schema=prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=prisma/schema.prisma"
  }
}
